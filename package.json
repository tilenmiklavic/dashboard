{
  "name": "dashboard",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "dev:web": "npm run tokens && vite",
    "dev:server": "node --watch src/server/index.ts",
    "build": "npm run tokens && tsc --noEmit && vite build",
    "start": "node src/server/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
